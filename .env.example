# Copy this file to .env, then replace the values with your real API keys.
# Never commit .env and never paste a real key into config.toml or chat.
#
# The variable NAMES are configured in config.toml:
#   [translate].api_key_env  -> DEEPSEEK_API_KEY
#   [image].api_key_env      -> IMAGE_API_KEY

# F group: German translation via DeepSeek official OpenAI-compatible endpoint.
DEEPSEEK_API_KEY=replace_with_your_deepseek_api_key

# K group: in-image English -> German via gpt-image-2 on https://api.inferera.com/v1
IMAGE_API_KEY=replace_with_your_inferera_api_key
