# 复制为 .env 并填写密钥。

# 文案翻译
DEEPSEEK_API_KEY=replace_with_your_deepseek_api_key

# 图片本地化
IMAGE_API_KEY=replace_with_your_inferera_api_key

# 飞书群自建机器人（两个群都必填；地址本身带 token，不要提交）
FEISHU_WEBHOOK_OPS=https://open.feishu.cn/open-apis/bot/v2/hook/replace_with_business_group_hook
FEISHU_WEBHOOK_TECH=https://open.feishu.cn/open-apis/bot/v2/hook/replace_with_technical_group_hook

# 机器人签名校验密钥。不配就必须在群里设关键词，卡片标题里的 Neakasa 当关键词用。
FEISHU_WEBHOOK_OPS_SECRET=replace_with_business_group_sign_secret
FEISHU_WEBHOOK_TECH_SECRET=replace_with_technical_group_sign_secret
