# 复制为 .env 并填写密钥。

# 文案翻译
DEEPSEEK_API_KEY=replace_with_your_deepseek_api_key

# 图片本地化
IMAGE_API_KEY=replace_with_your_inferera_api_key

# 同一业务群的四个机器人；每个地址都必填且不同，地址本身带 token，不要提交。
FEISHU_WEBHOOK_DETECT=https://open.feishu.cn/open-apis/bot/v2/hook/replace_with_detect_hook
FEISHU_WEBHOOK_CAPTURE=https://open.feishu.cn/open-apis/bot/v2/hook/replace_with_capture_hook
FEISHU_WEBHOOK_PUBLISH=https://open.feishu.cn/open-apis/bot/v2/hook/replace_with_publish_hook
FEISHU_WEBHOOK_ALERT=https://open.feishu.cn/open-apis/bot/v2/hook/replace_with_alert_hook

# 机器人签名校验密钥。不配就必须在群里设关键词，卡片标题里的 Neakasa 当关键词用。
FEISHU_WEBHOOK_DETECT_SECRET=replace_with_detect_sign_secret
FEISHU_WEBHOOK_CAPTURE_SECRET=replace_with_capture_sign_secret
FEISHU_WEBHOOK_PUBLISH_SECRET=replace_with_publish_sign_secret
FEISHU_WEBHOOK_ALERT_SECRET=replace_with_alert_sign_secret

# 飞书自建应用；**只有 [mirror] 的云盘镜像还要它**，发消息已改走上面的机器人。
FEISHU_APP_ID=replace_with_your_feishu_app_id
FEISHU_APP_SECRET=replace_with_your_feishu_app_secret
